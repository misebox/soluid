#!/bin/sh
set -e

echo "[pre-commit] typecheck"
bun run typecheck

echo "[pre-commit] test"
bun run test

echo "[pre-push] build:cli"
bun run build:cli

echo "[pre-push] check-build-freshness"
sh bin/check-build-freshness.sh

echo "[pre-push] check-cli-drift"
bash scripts/check-cli-drift.sh || echo "NOTE: run scripts/release-cli.sh when ready."

echo "[pre-push] check-components-drift"
bash scripts/check-components-drift.sh || echo "NOTE: run scripts/release-components.sh when ready."
